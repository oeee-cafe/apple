<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same iOS OAuth client as OeeeCafe-iOS-Info.plist: the Mac app is the
	     same bundle id (cafe.oeee), so Google takes it for the same app and the
	     site takes its tokens through the same [google].app_ids entry. The Mac
	     build generates its Info.plist from build settings, which is why this
	     file exists at all -- there is nowhere else to put a key of our own.
	     Left empty, a press on the site's Google button still comes to the app
	     -- the site sends Google to the native sheet on iOS and macOS
	     (app_sign_in.jinja in oeee-cafe/web) -- and the app answers it as a
	     sign-in that failed.

	     Xcode rewrites this file when it edits it and drops comments as it
	     goes, so if this is missing again that is where it went. -->
	<key>GoogleClientID</key>
	<string>371775747741-6g94c9vfojlsosc1673ppv99b2nmacd5.apps.googleusercontent.com</string>
</dict>
</plist>
